NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
# Docker MySQL 3308'de calisir (bilgisayardaki yerel MySQL 3306'yi kullaniyor olabilir)
DB_PORT=3308
DB_NAME=fizyoterapi
DB_USER=fizyo
DB_PASSWORD=fizyopass
DB_ROOT_PASSWORD=rootpass

# En az 32 karakter, rastgele bir deger kullan
JWT_SECRET=degistir-bunu-en-az-32-karakterlik-gizli-anahtar
JWT_EXPIRES_IN=1d

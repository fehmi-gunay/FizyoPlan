NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

DB_HOST=localhost
# Yerel geliştirme (npm run dev) için. Docker MySQL 3308'de çalışır; DB_* değerleri kökteki .env ile aynı olmalı
DB_PORT=3308
DB_NAME=fizyoplan
DB_USER=fizyoplan
DB_PASSWORD=fizyopass
DB_ROOT_PASSWORD=rootpass

# En az 32 karakter, rastgele bir deger kullan
JWT_SECRET=degistir-bunu-en-az-32-karakterlik-gizli-anahtar
JWT_EXPIRES_IN=1d

# Opsiyonel: `npm run db:seed` bu bilgilerle admin hesabı oluşturur (parola en az 12 karakter)
# SEED_ADMIN_EMAIL=admin@fizyo.local
# SEED_ADMIN_PASSWORD=guclu-bir-parola-belirle

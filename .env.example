# Docker Compose ayarları (kökteki docker-compose.yml). Kopyala: cp .env.example .env
DB_NAME=fizyoplan
DB_USER=fizyoplan
DB_PASSWORD=degistir-guclu-parola
DB_ROOT_PASSWORD=degistir-root-parolasi
DB_PORT=3308

# En az 32 karakter rastgele değer: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=degistir-bunu-en-az-32-karakterlik-gizli-anahtar
JWT_EXPIRES_IN=1d

# İlk açılışta oluşturulacak admin hesabı (parola en az 12 karakter)
SEED_ADMIN_EMAIL=admin@fizyo.local
SEED_ADMIN_PASSWORD=degistir-admin-parolasi

FRONTEND_PORT=8080
BACKEND_PORT=4001
